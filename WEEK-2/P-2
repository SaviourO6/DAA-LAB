// .cpp
#include <iostream>
using namespace std;
int main()
{
    // 1 2 3 5 8
    int n, i, j, k;
    cout << "Enter the number of elements: ";
    cin >> n;
    int arr[n];
    cout << "Enter the elements: ";
    for(i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    bool found = false;
    // arr[k] acts as target
    for(k = 0; k < n; k++)
    {
        i = 0;
        j = k - 1;
        // Two Pointer Search
        while(i < j)
        {
            int sum = arr[i] + arr[j];
            if(sum == arr[k])
            {
                found = true;
                break;
            }
            else if(sum < arr[k])
            {
                i++;
            }
            else
            {
                j--;
            }
        }
        if(found)
            break;
    }
    if(found)
    {
        cout << "The number at index " << i << " = " << arr[i] << " and the number at index " << j << " = " << arr[j] << " gives sum = " << arr[k] 
        << " present at index " << k << endl;
    }
    else
    {
        cout << "No such elements found";
    }
    return 0;
}
