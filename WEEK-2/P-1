// .cpp
#include <iostream>
using namespace std;
int main()
{
    int n, key;
    cout << "Enter number of elements: ";
    cin >> n;
    int arr[n];
    cout << "Enter sorted array:\n";
    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }
    cout << "Enter key: ";
    cin >> key;
    int low = 0;
    int high = n - 1;
    int index = -1;
    // Binary Search
    while(low <= high)
    {
        int mid = (low + high) / 2;
        if(arr[mid] == key)
        {
            index = mid;
            break;
        }
        else if(key > arr[mid])
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }
    // Key not found
    if(index == -1)
    {
        cout << "Not Present";
    }
    else
    {
        int count = 1;
        // Check left side
        int left = index - 1;
        while(left >= 0 && arr[left] == key)
        {
            count++;
            left--;
        }
        // Check right side
        int right = index + 1;
        while(right < n && arr[right] == key)
        {
            count++;
            right++;
        }
        cout << "Present\n";
        cout << "Number of copies = " << count;
    }
    return 0;
}
