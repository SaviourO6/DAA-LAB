#include <iostream>
using namespace std;
bool DFS(int graph[][100], int visited[], int recStack[], int current, int n)
{
    visited[current] = 1;
    recStack[current] = 1;
    for(int i = 0; i < n; i++)
    {
        if(graph[current][i] == 1)
        {
            if(!visited[i])
            {
                if(DFS(graph, visited, recStack, i, n))
                {
                    return true;
                }
            }
            else if(recStack[i])
            {
                return true;
            }
        }
    }
    recStack[current] = 0;
    return false;
}
int main()
{
    int n;
    cout << "Enter number of vertices: ";
    cin >> n;
    int graph[100][100];
    cout << "Enter adjacency matrix:\n";
    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < n; j++)
        {
            cin >> graph[i][j];
        }
    }
    int visited[100] = {0};
    int recStack[100] = {0};
    bool cycle = false;
    for(int i = 0; i < n; i++)
    {
        if(!visited[i])
        {
            if(DFS(graph, visited, recStack, i, n))
            {
                cycle = true;
                break;
            }
        }
    }
    if(cycle)
    {
        cout << "Cycle exists in graph";
    }
    else
    {
        cout << "No cycle exists";
    }
    return 0;
}
