#include <iostream>
#include <algorithm>
using namespace std;
int main()
{
    int n, key;
    cout << "Enter number of elements: ";
    cin >> n;
    int arr[n];
    cout << "Enter elements: ";
    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }
    cout << "Enter key: ";
    cin >> key;
    sort(arr, arr + n);
    int i = 0;
    int j = n - 1;
    bool found = false;
    while(i < j)
    {
        int sum = arr[i] + arr[j];

        if(sum == key)
        {
            found = true;
            break;
        }
        else if(sum < key)
        {
            i++;
        }
        else
        {
            j--;
        }
    }
    if(found)
    {
        cout << "Elements found: " << arr[i] << " and " << arr[j];
    }
    else
    {
        cout << "No such elements found";
    }
    return 0;
}
