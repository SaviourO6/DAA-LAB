#include <iostream>
using namespace std;
int main()
{
    int n, key;
    cout << "Enter number of elements: ";
    cin >> n;
    int arr[n];
    cout << "Enter sorted array:\n";
    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }
    cout << "Enter key element: ";
    cin >> key;
    int low = 0;
    int high = n - 1;
    int count = 0;
    bool found = false;
    while(low <= high)
    {
        count++;
        int mid = (low + high) / 2;
        if(arr[mid] == key)
        {
            found = true;
            break;
        }
        else if(key > arr[mid])
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }
    if(found)
        cout << "Present\n";
    else
        cout << "Not Present\n";
    cout << "Total comparisons = "  << count;
    return 0;
}
