#include <iostream>
#include <algorithm>
using namespace std;
int main()
{
    int n;
    cout << "Enter number of elements: ";
    cin >> n;
    int arr[n];
    cout << "Enter elements: ";
    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }
    sort(arr, arr + n);
    bool found = false;
    for(int i = 0; i < n - 1; i++)
    {
        if(arr[i] == arr[i + 1])
        {
            found = true;
            cout << "Duplicate element found = " << arr[i];
            break;
        }
    }
    if(!found)
    {
        cout << "No duplicate elements";
    }
    return 0;
}
