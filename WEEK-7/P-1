// .cpp
#include <iostream>
#include <climits>
using namespace std;
int main()
{
    int n;
    cout << "Enter number of vertices: ";
    cin >> n;
    int graph[100][100];
    cout << "Enter adjacency matrix:\n";
    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < n; j++)
        {
            cin >> graph[i][j];
        }
    }
    int source;
    cout << "Enter source vertex (Akshay's house): ";
    cin >> source;
    int dist[100];
    int visited[100] = {0};
    int parent[100];
    for(int i = 0; i < n; i++)
    {
        dist[i] = INT_MAX;
        parent[i] = -1;
    }
    dist[source] = 0;
    for(int count = 0; count < n - 1; count++)
    {
        int min = INT_MAX;
        int u;
        for(int i = 0; i < n; i++)
        {
            if(!visited[i] && dist[i] < min)
            {
                min = dist[i];
                u = i;
            }
        }
        visited[u] = 1;
        for(int v = 0; v < n; v++)
        {
            if(graph[u][v] && !visited[v] && dist[u] != INT_MAX && dist[u] + graph[u][v] < dist[v])
            {
                dist[v] = dist[u] + graph[u][v];
                parent[v] = u;
            }
        }
    }
    cout << "\nShortest Distances:\n";
    for(int i = 0; i < n; i++)
    {
        cout << "From " << source << " to " << i << " = " << dist[i] << endl;
    }
    return 0;
}
